// Configuração do Cloudflare Workers: o site é só de arquivos estáticos, sem
// script de servidor. O nome precisa ser o mesmo do Worker criado no painel.
// Um projeto do Cloudflare Pages ignora este arquivo.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calculos",
  "compatibility_date": "2026-01-01",
  "assets": {
    // A raiz do repositório é o site; o que não deve ir ao ar está em .assetsignore.
    "directory": "./"
  },
  // Prévia de cada PR (`npx wrangler preview`). O comando exige o bloco, mesmo
  // vazio: sem bindings, a prévia herda os arquivos e a data de compatibilidade acima.
  "previews": {}
}
